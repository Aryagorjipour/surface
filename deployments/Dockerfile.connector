# Build stage
FROM golang:1.27.2-alpine AS build
WORKDIR /src
RUN apk add --no-cache git ca-certificates
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /connector ./cmd/connector

# Runtime stage
FROM alpine:3.20
RUN apk add --no-cache ca-certificates
WORKDIR /app
COPY --from=build /connector /app/connector
RUN mkdir -p /app/data && chown -R 65534:65534 /app
USER 65534:65534
EXPOSE 8080
ENTRYPOINT ["/app/connector"]
